#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if rg --pcre2 -n '\[resolver-sim\.(?!extensions\.api\.v1\b)' packages/*/src; then
  echo "Executable package source imports a private PRF namespace" >&2
  exit 1
fi

echo "Executable package source imports only the public PRF extension API"
